# Set to 1 when using Azure-backed storage.
CLOUD_STORAGE_ENABLED=0

# Local development/test override.
# Leave blank when using Azure Key Vault.
DATABASE_URL=

# Azure Key Vault configuration.
# DefaultAzureCredential supplies authentication through managed identity,
# Azure CLI login, or another supported Azure credential source.
AZURE_KEY_VAULT_URL=https://your-key-vault-name.vault.azure.net/
AZURE_DATABASE_SECRET_NAME=database-url
